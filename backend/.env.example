# Copiá este archivo como ".env" y cambiá los valores.
# El archivo .env NO se sube a GitHub (está en .gitignore).

PORT=4000

# Credenciales del panel de administración
ADMIN_USER=admin
ADMIN_PASSWORD=cambiame-por-una-clave-larga

# Texto secreto para firmar las sesiones (cualquier cadena larga y aleatoria).
# Si no lo definís, se genera uno nuevo en cada arranque y las sesiones se cierran al reiniciar.
TOKEN_SECRET=

# Dirección del frontend publicado en GitHub Pages (para CORS). Ejemplo:
# CORS_ORIGIN=https://tu-usuario.github.io
CORS_ORIGIN=*

# Poné true si el backend corre detrás de un proxy (Render, Railway...) para leer la IP real.
TRUST_PROXY=false

# Si es false, el backend NO sirve la carpeta frontend/ (solo expone la API).
SERVE_FRONTEND=true
